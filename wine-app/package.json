{
  "name": "wine-app",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/electron-main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron-main && electron .",
    "build": "tsc -b && npm run test && vite build",
    "build:electron-main": "tsc -p tsconfig.electron.json",
    "build:electron": "npm run build && npm run build:electron-main && electron-builder",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "VITEST_INCLUDE='src/**/*.integration.test.{ts,tsx}' vitest run",
    "test:all": "VITEST_INCLUDE='src/**/*.{test,spec,integration.test}.{ts,tsx}' vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "csv-parser": "^3.0.0",
    "electron-is-dev": "^3.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.0.0",
    "sql.js": "^1.14.1",
    "uuid": "^13.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.10",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.2",
    "autoprefixer": "^10.4.27",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.9",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  },
  "build": {
    "appId": "com.example.winecellar",
    "productName": "Wine Cellar",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
